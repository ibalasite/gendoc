#!/usr/bin/env bash
# gendoc setup — install / uninstall / upgrade
# Usage:
#   ./setup             # install (default)
#   ./setup install     # same as above
#   ./setup uninstall   # remove hook + delete runtime
#   ./setup upgrade     # git pull + re-deploy

set -e

REPO_URL="https://github.com/ibalasite/gendoc.git"
RUNTIME_DIR="$HOME/.claude/skills/gendoc"
SKILLS_SRC="$RUNTIME_DIR/skills"
CLAUDE_SKILLS_DIR="$HOME/.claude/skills"
SETTINGS_HOOK="$RUNTIME_DIR/bin/gendoc-settings-hook.py"
HOOK_CMD="bash \"$RUNTIME_DIR/bin/gendoc-session-update\""

CMD="${1:-install}"

log() { echo "$@"; }

# Try python3 first, fall back to python — handles Windows Git Bash where
# python3 may be an MS Store stub (exits non-zero / opens Store).
_find_python() {
  for candidate in python3 python; do
    if command -v "$candidate" >/dev/null 2>&1; then
      if "$candidate" --version 2>&1 | grep -q "^Python 3"; then
        echo "$candidate"; return 0
      fi
    fi
  done
  return 1
}

PY=$(_find_python) || true   # resolved after clone when called early; checked per-command below

# ── install ───────────────────────────────────────────────────────────────────
do_install() {
  command -v git >/dev/null 2>&1 || { echo "❌ git required"; exit 1; }
  PY=$(_find_python) || { echo "❌ Python 3 not found (tried python3 and python)"; exit 1; }

  if [[ -d "$RUNTIME_DIR/.git" ]]; then
    log "[install] $RUNTIME_DIR 已存在，執行 upgrade..."
    do_upgrade
    return
  fi

  log "[install] clone gendoc → $RUNTIME_DIR"
  git clone "$REPO_URL" "$RUNTIME_DIR"

  _deploy_skills
  _deploy_tools
  _register_hook

  log ""
  log "[install] 完成！重啟 Claude Code 讓技能生效。"
  log "  · 手動升級：$RUNTIME_DIR/setup upgrade"
  log "  · 解除安裝：$RUNTIME_DIR/setup uninstall"
}

# ── uninstall ─────────────────────────────────────────────────────────────────
do_uninstall() {
  PY=$(_find_python) || { echo "❌ Python 3 not found (tried python3 and python)"; exit 1; }
  log "[uninstall] 移除 hook..."
  if [[ -f "$SETTINGS_HOOK" ]]; then
    "$PY" "$SETTINGS_HOOK" remove
    "$PY" "$SETTINGS_HOOK" remove-guard
  fi

  log "[uninstall] 移除 copied skills..."
  if [[ -d "$SKILLS_SRC" ]]; then
    for skill_dir in "$SKILLS_SRC"/*/; do
      name="$(basename "$skill_dir")"
      [[ -d "$CLAUDE_SKILLS_DIR/$name" ]] && rm -rf "$CLAUDE_SKILLS_DIR/$name" && log "  · 刪除 ~/.claude/skills/$name"
    done
  fi

  log "[uninstall] 刪除 $RUNTIME_DIR..."
  rm -rf "$RUNTIME_DIR"

  log "[uninstall] 完成。"
}

# ── upgrade ───────────────────────────────────────────────────────────────────
do_upgrade() {
  if [[ ! -d "$RUNTIME_DIR/.git" ]]; then
    log "[upgrade] 找不到 $RUNTIME_DIR，請先執行 install。"
    exit 1
  fi

  log "[upgrade] git pull..."
  git -C "$RUNTIME_DIR" pull --ff-only

  # Re-exec the freshly pulled setup so new functions (e.g. _register_hook) take effect
  exec "$RUNTIME_DIR/setup" _post_upgrade
}

_post_upgrade() {
  _deploy_skills
  _deploy_tools
  _register_hook

  log "[upgrade] 完成。"
}

# ── helpers ───────────────────────────────────────────────────────────────────
_deploy_skills() {
  log "[deploy] 複製 skills → ~/.claude/skills/"
  mkdir -p "$CLAUDE_SKILLS_DIR"
  for skill_dir in "$SKILLS_SRC"/*/; do
    name="$(basename "$skill_dir")"
    rm -rf "$CLAUDE_SKILLS_DIR/$name"
    cp -r "$skill_dir" "$CLAUDE_SKILLS_DIR/$name"
    log "  · $name"
  done
}

_deploy_tools() {
  log "[deploy] 部署 tools/<package>/ 源碼至 $RUNTIME_DIR/tools/bin/"
  # Source-of-truth packages live in tools/<package>/, runtime executables go to tools/bin/.
  # 設計：tools/<package>/ 含 dev source + tests + fixtures（由 pytest 跑）；
  # 部署時把 source 複製或 build 到 tools/bin/ 作為 runtime 執行體。
  #
  # 兩種部署模式（依 package 內檔案存在與否自動選）：
  #   1. build.sh — 若 tools/<package>/build.sh 存在 → 執行它，由 build.sh
  #                  自行決定產物（適合需要 compile / bundle / minify 的 package）
  #                  build.sh 拿到環境變數：BIN_DIR、PACKAGE_DIR
  #   2. convention — 否則自動 cp tools/<package>/<package>.py → bin/<package>.py
  #                    （單檔 Python script 的最簡 case）
  local bin_dir="$RUNTIME_DIR/tools/bin"
  mkdir -p "$bin_dir"
  for pkg_dir in "$RUNTIME_DIR/tools"/*/; do
    local pkg_name
    pkg_name=$(basename "$pkg_dir")
    # 跳過 bin 自己（避免遞迴）
    [[ "$pkg_name" == "bin" ]] && continue

    if [[ -f "$pkg_dir/build.sh" ]]; then
      log "  · build $pkg_name (running build.sh)"
      if ! ( cd "$pkg_dir" \
             && BIN_DIR="$bin_dir" PACKAGE_DIR="$pkg_dir" bash build.sh ); then
        log "  ✗ build.sh failed for $pkg_name"
        return 1
      fi
    else
      # Convention: <package>/<package>.py → bin/<package>.py
      local entry="$pkg_dir$pkg_name.py"
      if [[ -f "$entry" ]]; then
        cp "$entry" "$bin_dir/$pkg_name.py"
        log "  · $pkg_name/$pkg_name.py → bin/$pkg_name.py"
      fi
    fi
  done
}

_register_hook() {
  PY=$(_find_python) || { echo "❌ Python 3 not found (tried python3 and python)"; exit 1; }
  log "[deploy] 註冊 SessionStart hook..."
  "$PY" "$SETTINGS_HOOK" add "$HOOK_CMD"
  log "[deploy] 註冊 guard hooks (PreToolUse / PostToolUse / Stop)..."
  "$PY" "$SETTINGS_HOOK" add-guard "$RUNTIME_DIR/tools/bin"
}

# ── dispatch ──────────────────────────────────────────────────────────────────
case "$CMD" in
  install)       do_install ;;
  uninstall)     do_uninstall ;;
  upgrade)       do_upgrade ;;
  _post_upgrade) _post_upgrade ;;
  *)
    echo "用法：./setup [install|uninstall|upgrade]"
    echo "  install   — clone + deploy + register hook（預設）"
    echo "  uninstall — 移除 hook + 刪除 runtime"
    echo "  upgrade   — git pull + re-deploy"
    exit 1
    ;;
esac
